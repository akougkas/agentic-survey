SURVEY_API_IMAGE=registry.example/agentic-survey-api:M11.10
SURVEY_WEB_IMAGE=registry.example/agentic-survey-web:M11.10

SURVEY_ADMIN_PASSWORD=change-me
SURVEY_PUBLIC_BASE_URL=https://citadl.gnosis.run
SURVEY_FRONTEND_ORIGIN=https://citadl.gnosis.run
SURVEY_PRODUCT_BUNDLE_DIR=/app/citadl/bundle

SURVEY_LLM_ENABLED=true
SURVEY_LITELLM_CONFIG=agentic_survey/llm/litellm_config.yaml
SURVEY_MINI_ENDPOINT_URL=http://mini:8080/v1
SURVEY_MINI_MODEL=gemma-4-26B-A4B-it-Q4_K_M
SURVEY_DYNAMO_ENDPOINT_URL=http://dynamo:1234/v1
SURVEY_DYNAMO_MODEL=nvidia-nemotron-3-nano-omni-30b-a3b-reasoning
SURVEY_DYNAMO_CONTEXT_WINDOW_TOKENS=600000
SURVEY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
SURVEY_DEFAULT_INTERVIEWER_ENDPOINT=mini
SURVEY_LLM_TIMEOUT_SECONDS=60
SURVEY_LLM_VISIBLE_REPLY_MAX_TOKENS=512
SURVEY_LLM_REPAIR_COMPLETION_TOKENS=1024
SURVEY_LLM_REASONING_BUDGET_TOKENS=8192
SURVEY_LLM_REASONING_FINAL_RESPONSE_TOKENS=4096
SURVEY_LLM_PREPLAN_REASONING_BUDGET_TOKENS=1024

SURVEY_REPOSITORY=surreal
SURVEY_SURREAL_URL=ws://surrealdb:8000/rpc
SURVEY_SURREAL_NS=agentic
SURVEY_SURREAL_DB=citadl
SURVEY_SURREAL_USER=root
SURVEY_SURREAL_PASS=root
SURVEY_EXPORT_DIR=/app/campaigns

SURVEY_SEARXNG_URL=http://searxng:8080
SURVEY_FRESHNESS_DEFAULT_CRON="0 3 * * *"
SURVEY_WEB_SEARCH_TOP_K=10
SURVEY_FRESHNESS_POLL_SECONDS=30
SURVEY_INGEST_MIN_CHARS=500
SURVEY_INGEST_CRAWL4AI=true
SURVEY_INGEST_HTTP_TIMEOUT_SECONDS=30
SURVEY_INGEST_CRAWL4AI_TIMEOUT_SECONDS=60
