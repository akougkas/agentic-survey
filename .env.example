# --- Runtime identity ---
SURVEY_PUBLIC_BASE_URL=http://localhost:5270
SURVEY_FRONTEND_ORIGIN=http://localhost:5270
# Active product bundle. Defaults to the bundled demo; swap to `./citadl/bundle`
# (or any absolute path) to mount a different product.
SURVEY_PRODUCT_BUNDLE_DIR=examples/product-bundles/demo

# --- Admin + web ---
SURVEY_ADMIN_PASSWORD=change-me

# --- LLM routing (two brain profiles) ---
# Two logical brains, each independently configurable:
#   - chatter (Brain A — Mira's voice). Conversational. High temperature so the
#     surface dialog stays warm and varied. Reasoning always off because the
#     participant sees this stream live.
#   - scientist (Brain B + Validator + Analyst + Ingest). Tool-using, analytical.
#     Lower temperature keeps tool selection focused. Set
#     SURVEY_SCIENTIST_SUPPORTS_REASONING=true only when the deployed model
#     genuinely supports a thinking mode (Nemotron OMNI, Qwen3-Thinking). When
#     false the catalog clamps every scientist-family role to reasoning_mode=off
#     so a non-thinking model (Gemma, AgenticQwen, Qwen3-base) does not burn
#     per-turn latency on stream-of-consciousness deliberation.
# Both URLs may point at the same physical backend (single-machine deploys); a
# single llama.cpp / LM Studio process serves both brains and per-call temperature
# / enable_thinking overrides differentiate the request shapes.
SURVEY_LLM_ENABLED=true
SURVEY_LITELLM_CONFIG=services/api/agentic_survey/llm/litellm_config.yaml
SURVEY_CHATTER_ENDPOINT_URL=http://localhost:8080/v1
SURVEY_CHATTER_MODEL=AgenticQwen-30B-A3B-i1-Q4_K_M
SURVEY_CHATTER_TEMPERATURE=0.7
SURVEY_SCIENTIST_ENDPOINT_URL=http://localhost:8080/v1
SURVEY_SCIENTIST_MODEL=AgenticQwen-30B-A3B-i1-Q4_K_M
SURVEY_SCIENTIST_TEMPERATURE=0.3
SURVEY_SCIENTIST_SUPPORTS_REASONING=false
SURVEY_SCIENTIST_CONTEXT_WINDOW_TOKENS=200000
SURVEY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
SURVEY_DEFAULT_INTERVIEWER_ENDPOINT=chatter
SURVEY_LLM_TIMEOUT_SECONDS=60
SURVEY_LLM_VISIBLE_REPLY_MAX_TOKENS=4096
SURVEY_LLM_REPAIR_COMPLETION_TOKENS=1024
SURVEY_LLM_REASONING_BUDGET_TOKENS=8192
SURVEY_LLM_REASONING_FINAL_RESPONSE_TOKENS=4096
SURVEY_LLM_PREPLAN_REASONING_BUDGET_TOKENS=1024

# --- Storage adapters ---
SURVEY_REPOSITORY=memory
SURVEY_SURREAL_URL=ws://localhost:8400
SURVEY_SURREAL_NS=agentic_survey
SURVEY_SURREAL_DB=prod
SURVEY_SURREAL_USER=root
SURVEY_SURREAL_PASS=root
SURVEY_EXPORT_DIR=./campaigns

# --- Other services ---
SURVEY_SEARXNG_URL=http://searxng:8080
SURVEY_FRESHNESS_DEFAULT_CRON="0 3 * * *"

# --- Web search (M3) ---
# Design-time only. SearXNG primary when SURVEY_SEARXNG_URL is set;
# DuckDuckGo (via `ddgs`) is the fallback. Interview surface never calls
# web. POST /admin/campaigns/{id}/knowledge/search rejects 400 once the
# campaign reaches live or monitoring.
SURVEY_WEB_SEARCH_TOP_K=10

# --- Ingestion worker (M2) ---
# The worker (`python -m agentic_survey.tools.freshness`) polls for queued
# knowledge_source rows and walks them through fetching → extracting →
# chunking → embedding → pending_approval. Tier-1 fetcher is httpx +
# readability-lxml (or pypdf); short content escalates to crawl4ai when
# SURVEY_INGEST_CRAWL4AI=true (and the `ingest` extra is installed).
SURVEY_FRESHNESS_POLL_SECONDS=30
SURVEY_INGEST_MIN_CHARS=500
SURVEY_INGEST_CRAWL4AI=true
SURVEY_INGEST_HTTP_TIMEOUT_SECONDS=30
SURVEY_INGEST_CRAWL4AI_TIMEOUT_SECONDS=60

# --- OpenRouter fallback for scientist-served roles ---
# When SURVEY_OPENROUTER_FALLBACK_ENABLED=true and SURVEY_OPENROUTER_API_KEY is
# non-empty, every catalog role hosted on the scientist endpoint (Brain B,
# validator, analyst, ingest) gains a parallel router entry pointing at
# OpenRouter. LiteLLM's Router rotates across same-named backends on
# connection failure, so the local backend stays primary and OpenRouter fires
# on outage. Leave the key empty in committed copies; populate the real value
# only in .env.
SURVEY_OPENROUTER_API_KEY=sk-or-v1-...placeholder...
SURVEY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SURVEY_OPENROUTER_SCIENTIST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SURVEY_OPENROUTER_FALLBACK_ENABLED=false
