# --- Runtime identity ---
SURVEY_PUBLIC_BASE_URL=http://localhost:5270
SURVEY_FRONTEND_ORIGIN=http://localhost:5270
# Leave unset to use the bundled demo product. Point this at `./citadl/bundle`
# to run the in-repo Citadl product instead.
# SURVEY_PRODUCT_BUNDLE_DIR=/absolute/path/to/agentic-survey/citadl/bundle

# --- Admin + web ---
SURVEY_ADMIN_PASSWORD=change-me

# --- LLM routing ---
# Flip this on to actually call mini/dynamo. When false, all agents use heuristic fallbacks.
SURVEY_LLM_ENABLED=true
SURVEY_LITELLM_CONFIG=services/api/agentic_survey/llm/litellm_config.yaml
SURVEY_MINI_ENDPOINT_URL=http://mini.tail-...:8080/v1
# Legacy fallback: used when model_catalog has no default entry for a role.
SURVEY_MINI_MODEL=Qwen35-Distilled-i1-Q4_K_M
SURVEY_DYNAMO_ENDPOINT_URL=http://dynamo.tail-...:1234/v1
# Legacy fallback: used when model_catalog has no default entry for a role.
SURVEY_DYNAMO_MODEL=nemotron-cascade-2-30b-a3b-i1
SURVEY_EMBEDDING_MODEL=nomic-embed-text-v2-moe
SURVEY_LLM_TIMEOUT_SECONDS=60

# --- Storage adapters ---
SURVEY_REPOSITORY=memory
SURVEY_SURREAL_URL=ws://localhost:8400
SURVEY_SURREAL_NS=agentic_survey
SURVEY_SURREAL_DB=prod
SURVEY_SURREAL_USER=root
SURVEY_SURREAL_PASS=root
SURVEY_EXPORT_DIR=./campaigns

# --- Other services ---
SURVEY_SEARXNG_URL=http://searxng:8080
SURVEY_FRESHNESS_DEFAULT_CRON=0 3 * * *
